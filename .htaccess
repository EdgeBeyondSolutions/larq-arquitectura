# .htaccess — larqad.com (Hostinger / Apache)

# ===== HTTPS forzado =====
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# ===== www -> sin www (coincide con las URLs canónicas del sitio) =====
RewriteCond %{HTTP_HOST} ^www\.larqad\.com$ [NC]
RewriteRule ^(.*)$ https://larqad.com/$1 [L,R=301]

# ===== Compresión (reduce el peso transferido) =====
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ===== Cache-Control por tipo de archivo =====
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: siempre revalidar, no cachear fuerte (el contenido cambia)
  ExpiresByType text/html "access plus 0 seconds"

  # CSS/JS: llevan ?v=1 para romper caché cuando se actualizan, se pueden cachear largo
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Imágenes y video: contenido estable, cache largo
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"

  # Fuentes
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # Manifest / otros
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|ico|mp4|woff2?|)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ===== Páginas limpias sin .html en la URL (opcional, desactivado por default) =====
# Las URLs actuales del sitio usan .html explícito (index.html, servicios.html, etc.)
# así que no se activa reescritura de extensión para no romper enlaces existentes.
